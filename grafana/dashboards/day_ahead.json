      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "njord-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (model, valid_for) model, delivery_day, valid_for, p10, p50, p90\n  FROM price_forecast\n  WHERE valid_for >= $__timeFrom() AND valid_for < $__timeTo()\n  ORDER BY model, valid_for, issued_at DESC\n)\nSELECT valid_for AS \"time\", p10 AS \"P10\", p50 AS \"P50\", p90 AS \"P90\"\nFROM latest WHERE model = '$model' ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "njord-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT valid_for AS \"time\", price AS \"Actual MID\"\nFROM market_index_price\nWHERE provider = 'APXMIDP' AND valid_for >= $__timeFrom() AND valid_for < $__timeTo() ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "njord-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (model, valid_for) model, delivery_day, valid_for, p10, p50, p90\n  FROM price_forecast\n  WHERE valid_for >= $__timeFrom() AND valid_for < $__timeTo()\n  ORDER BY model, valid_for, issued_at DESC\n)\nSELECT valid_for AS \"time\", model || ' P50' AS metric, p50 AS value\nFROM latest WHERE model <> '$model' ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Power day summary",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "njord-timescaledb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P10–P90 coverage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "njord-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (model, valid_for) model, delivery_day, valid_for, p10, p50, p90\n  FROM price_forecast\n  WHERE valid_for >= $__timeFrom() AND valid_for < $__timeTo()\n  ORDER BY model, valid_for, issued_at DESC\n)\nSELECT f.model AS \"Model\",\n       avg(abs(f.p50 - p.price)) AS \"MAE\",\n       avg((p.price BETWEEN f.p10 AND f.p90)::int) AS \"P10–P90 coverage\",\n       max(f.p50) - min(f.p50) AS \"Forecast spread (max - min)\",\n       max(p.price) - min(p.price) AS \"Actual spread (max - min)\"\nFROM latest f\nLEFT JOIN market_index_price p ON p.provider = 'APXMIDP' AND p.valid_for = f.valid_for\nGROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}
